# SafeSweep v0 — Ethereum Sepolia <-> Reactive Lasna
# Copy to .env. Never commit .env.

# RPCs
SEPOLIA_RPC_URL=
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/

# Recommended signer: an encrypted Foundry keystore account.
# Create it locally with: ./scripts/safesweep.sh wallet-import
SAFESWEEP_ACCOUNT=safesweep-testnet

# Optional automation-only fallback for a dedicated TESTNET key.
# Prefer SAFESWEEP_ACCOUNT for manual live deployment. Never use a production key.
PRIVATE_KEY=

# SafeSweep actors
# For the simplest demo, GUARDIAN_ADDRESS should be the signer account address.
GUARDIAN_ADDRESS=
SAFE_WALLET_ADDRESS=

# Current Reactive Network testnet constants (verified 2026-11-18)
SEPOLIA_CHAIN_ID=11155111
LASNA_CHAIN_ID=5318007
REACTIVE_SYSTEM_ADDRESS=0x8888888888888888888888888888888888888888
SEPOLIA_CALLBACK_PROXY=0xAa14d9Cd0f788Ca23d11805986C1d8bd035D23b4
SEPOLIA_REACTIVE_FAUCET=0x9b9BB25f1A81078C544C829c5EB7822d747Cf434
LREACT_FAUCET_WEI=100000000000000000

# Filled after deployment when using individual scripts. ship-live.sh captures these automatically.
REACTIVE_ADDRESS=
VAULT_ADDRESS=

# Suggested demo funding; change if needed.
REACTIVE_RESERVE_WEI=1000000000000000000
CALLBACK_RESERVE_WEI=100000000000000000
VAULT_DEMO_WEI=10000000000000000
